# ============================================
# FastCode MVP — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ---- Database ----
DATABASE_URL=postgresql://fastcode:devpassword@localhost:5432/fastcode

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- JWT ----
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---- App ----
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ---- Sandbox ----
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_LIMIT=0.5
